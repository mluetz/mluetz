# ============================================================
# ICT & TPRM Cockpit – Umgebungsvariablen (Beispiel)
# Kopieren nach .env und Werte setzen. NIEMALS echte Secrets committen.
# ============================================================

# --- Datenbank -------------------------------------------------
# Lokale Entwicklung (SQLite):
DATABASE_URL="file:./dev.db"
# Produktion (PostgreSQL) – Provider in prisma/schema.prisma auf "postgresql" stellen:
# DATABASE_URL="postgresql://cockpit:CHANGE_ME@db:5432/cockpit?schema=public"

# --- Session / Auth -------------------------------------------
# Mind. 32 Zeichen Zufallswert, z. B.:  openssl rand -base64 48
SESSION_SECRET="CHANGE_ME_generate_a_random_value_min_32_chars"

# Demo-Login nur in Entwicklungsumgebungen aktivieren.
# In Produktion "false" setzen und OIDC/Entra ID konfigurieren (siehe docs/architecture).
AUTH_DEMO_LOGIN="true"

# MFA-Pflicht (TOTP) beim Login, kommagetrennte Rollen-Keys.
# Standard (leer): ADMIN,ISO,SECOND_LINE — "none" deaktiviert die Pflicht
# (nur für Demo-Umgebungen). Beim ersten Login wird die Einrichtung erzwungen;
# Wiederherstellungscodes werden einmalig angezeigt.
# MFA_REQUIRED_ROLES=""

# Vorbereitung Enterprise-SSO (noch nicht aktiv, siehe ADR-0003):
# AUTH_OIDC_ISSUER="https://login.microsoftonline.com/<tenant>/v2.0"
# AUTH_OIDC_CLIENT_ID=""
# AUTH_OIDC_CLIENT_SECRET=""

# --- Anwendung -------------------------------------------------
# Basis-URL (für Links in Reports/Exporten) UND maßgeblich für das
# Secure-Flag des Session-Cookies: Bei "http://…" wird das Flag NICHT gesetzt,
# da Browser Secure-Cookies über unverschlüsselte Verbindungen verwerfen
# (sonst Endlosschleife zur Login-Seite). Bei "https://…" ist es aktiv.
APP_BASE_URL="http://localhost:3000"

# TLS-Terminierung durch Caddy (docker-compose.synology.yml): Site-Adresse des
# HTTPS-Blocks. Muss einen Host enthalten – ein hostloses ":8443" liefert kein
# Zertifikat. Der Synology-Installer trägt hier die NAS-IP ein.
CADDY_SITE_ADDRESS="https://localhost:8443"

# Optionaler Override des Secure-Flags ("true"/"false"); leer = automatisch
# aus APP_BASE_URL ableiten. Nur setzen, wenn die Automatik nicht passt
# (z. B. TLS-Terminierung durch einen Proxy bei abweichender Basis-URL).
# SESSION_COOKIE_SECURE=""
# Standard-Sprache: de | en
APP_DEFAULT_LOCALE="de"

# --- Fristen-Scan (P1-07) --------------------------------------
# Stündlicher Aufruf von /api/cron/deadlines (z. B. Synology-Aufgabenplaner):
#   curl -fsS -H "Authorization: Bearer $CRON_SECRET" https://<host>/api/cron/deadlines
CRON_SECRET="CHANGE_ME_random_value"
# Optionaler Webhook für externe Zustellung (Mail-Relay, Teams, Slack ...):
# NOTIFY_WEBHOOK_URL=""
# Aufbewahrungsdauer des Audit Trails in Tagen (Integritäts-Job meldet
# Überschreitungen; gelöscht wird nie automatisch):
# AUDIT_RETENTION_DAYS="3650"

# --- Umgebung und Mandant (Redesign Welle 4, D-14) --------------
# Umgebungskennzeichen: demo | test | prod (steuert das schmale Farbband)
APP_ENVIRONMENT="demo"
# Mandantenname in der Kopfzeile
APP_TENANT_NAME="Nordlicht Bank AG"
