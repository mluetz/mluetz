# ============================================================
# TLS-Terminierung für das ICT & TPRM Cockpit (Review v3, S-01)
# ------------------------------------------------------------
# - HTTPS auf :8443 mit Caddy-internem Zertifikat (eigene CA;
#   Root-Zertifikat liegt im Volume caddy-data unter
#   /data/caddy/pki/authorities/local/root.crt und wird einmalig
#   auf den Clients als vertrauenswürdig hinterlegt)
# - HTTP auf :8080 leitet ausschließlich auf HTTPS um
# - HSTS aktiv; keine Inhalte über Klartext
# ============================================================

{
	auto_https disable_redirects
}

# Der Host muss ausgeschrieben sein: Aus einem hostlosen Block wie ":8443"
# kann der interne Issuer kein Zertifikat ableiten (TLS-Alert 80, "no peer
# certificate"). CADDY_SITE_ADDRESS setzt der Installer auf die NAS-IP.
{$CADDY_SITE_ADDRESS:https://localhost:8443} {
	tls internal
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
	reverse_proxy cockpit:3000
}

# Schema ausgeschrieben: Ohne "http://" behandelt Caddy auch diesen Block als
# TLS-fähig. Beide hostlosen Blöcke landen dann in derselben Catch-all-
# Automation-Policy und widersprechen sich ("automation policy ... in
# conflict") – Caddy bricht schon beim Parsen ab.
http://:8080 {
	redir https://{host}:8443{uri} permanent
}
